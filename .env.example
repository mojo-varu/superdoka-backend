# Copy to .env for local development. Never commit .env itself.
# Names only here — no real values. See app/channels/settings.py for how
# these are read and docs/runbooks/local_dev.md for how to set them up.

# --- Existing app (unchanged) ---
DATABASE_URL=
TEST_DATABASE_URL=
S3_BUCKET=
GROUP_MESSAGE_SECRET_KEY=

# --- Telegram bot channel (new, WP-A) ---
# TELEGRAM_MODE: "polling" for local dev, "webhook" for the VPS.
TELEGRAM_MODE=polling
# BOT_ENV: "dev" or "prod" — selects which token below is used. Never run
# polling against the prod token while a webhook is set (see admin CLI).
BOT_ENV=dev

# Separate dev/prod tokens (ADR-0021). Create the dev bot in BotFather
# yourself; never reuse the prod token locally.
TELEGRAM_BOT_TOKEN_DEV=
TELEGRAM_BOT_TOKEN_PROD=

# Only required when TELEGRAM_MODE=webhook.
WEBHOOK_SECRET=
WEBHOOK_BASE_URL=

# Optional tuning (all have conservative defaults, see settings.py).
BOT_WORKER_CONCURRENCY=
BOT_STUCK_ROW_SECONDS=
BOT_FLOOD_LIMIT_PER_MINUTE=
BOT_CALLBACK_EXPIRY_HOURS=
